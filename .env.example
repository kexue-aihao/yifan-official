PORT=3001
# The public origin must match the browser origin. Use HTTPS in production.
APP_ORIGIN=http://localhost:5173
YIFAN_DATA_DIR=./data
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional fixed key. If empty, generated in data/settings.key. Back up with installation.json.
# Encrypts MySQL credentials and Epay secrets. Never change after installation.
SETTINGS_ENCRYPTION_KEY=
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
