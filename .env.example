PORT=3001
# The public origin must match the browser origin. Use HTTPS in production.
APP_ORIGIN=http://localhost:5173
YIFAN_DATA_DIR=./data
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional fixed key. If empty, generated in data/settings.key. Back up with installation.json.
# Encrypts MySQL credentials and Epay secrets. Never change after installation.
SETTINGS_ENCRYPTION_KEY=
# 0 = direct; 1 = loopback reverse proxy only. Otherwise comma-separated
# trusted proxy IPs/CIDRs, e.g. 127.0.0.1,::1,10.20.0.5/32.
# Your reverse proxy must overwrite X-Forwarded-For with the actual client IP.
# With a CDN, restore the client IP at Nginx using only trusted CDN ranges first.
# Restrict the Node port to the configured proxies. Restart after changing this.
TRUST_PROXY=0
