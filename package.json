{
  "name": "yifan-official",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"node scripts/web-dev.mjs\"",
    "build": "vite build && vite build --ssr src/entry-server.ts --outDir dist/server",
    "start": "node server/index.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "test:platforms": "node scripts/verify-platforms.mjs",
    "test:refresh": "node scripts/verify-refresh.mjs",
    "test:motion": "node scripts/verify-motion.mjs",
    "test:hardening": "node scripts/verify-hardening.mjs",
    "check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vue/server-renderer": "^3.5.44",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.1.0",
    "intl-messageformat": "^12.1.3",
    "ipaddr.js": "^2.5.0",
    "lucide-vue-next": "^0.468.0",
    "motion-v": "^2.8.0",
    "mysql2": "^3.24.6",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
